# No pongas contraseñas aquí. Copia a .env LOCAL o configura variables privadas en el panel.
NODE_ENV=production
FRONTEND_ORIGIN=https://TUCUENTA.alwaysdata.net
DB_HOST=mysql-TUCUENTA.alwaysdata.net
DB_PORT=3306
DB_USER=TU_USUARIO_MYSQL
DB_PASSWORD=CAMBIAR_POR_SECRETO_PRIVADO
DB_NAME=TU_BASE_MYSQL
# alwaysdata asigna IP y PORT a cada sitio Node.js: no fuerces valores fijos.
# FastAPI en Render. La API key debe coincidir con INFERENCE_API_KEY del servicio Python.
INFERENCE_API_URL=https://servicio-ia-uvas.onrender.com
INFERENCE_API_KEY=COLOCA_AQUI_LA_MISMA_CLAVE_DE_RENDER
# Render Free puede tardar al reactivarse. Tiempo maximo en milisegundos.
INFERENCE_TIMEOUT_MS=180000
# Debe coincidir con MAX_UPLOAD_BYTES de FastAPI (por defecto 8 MB).
INFERENCE_MAX_IMAGE_BYTES=8388608
# Solo funciona si la cámara es accesible desde el servidor; NO una IP LAN normal.
# ESP32_IP=http://IP_DEL_PUENTE_LOCAL/capture
